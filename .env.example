# ThermalSentinel Environment Configuration Template
# Copy this file to .env and configure your credentials.

FIRMS_MAP_KEY=
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
GEMINI_API_KEY=
DATABASE_URL=

# Optional: ArcGIS Online API key for high-resolution Esri World Imagery satellite basemap
# If omitted or expired, client automatically uses default public Esri / CartoDB fallback tiles
VITE_ARCGIS_API_KEY=

# Optional: CARTO API Key for dark matter basemaps
# Get key from https://carto.com/basemaps/apikey/ to remove "API KEY REQUIRED" watermark
VITE_CARTO_API_KEY=
